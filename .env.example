# OpenRouter key used for every model call
OPENROUTER_API_KEY=sk-or-replace-me
# Postgres connection string (app data and LangGraph checkpoints). On Neon: the pooled URL Vercel injects (unused when DATABASE_URL_UNPOOLED is set). On Supabase: the Session pooler string (port 5432)
DATABASE_URL=postgresql://user:password@localhost:5432/assistant
# Direct (not pooled) connection. Set DATABASE_URL_UNPOOLED on Neon (Vercel Marketplace injects it): the bot then uses the direct connection for everything. Leave empty on Supabase
DATABASE_URL_UNPOOLED=
# Schema every table lives in (created on start). On Supabase, never add it to the API's "Exposed schemas"
DB_SCHEMA=assistant
# Connections per instance: the app's pool and LangGraph's. Instances alive x 2 (x 3 when busy) must stay under the pooler's size
DB_POOL_MAX=2
SAVER_POOL_MAX=1
# Files: with S3_BUCKET, S3_ACCESS_KEY and S3_SECRET_KEY all empty (and SUPABASE_* empty), files are kept on local disk
# under DATA_DIR and served by this bot with signed /v1/files links on PUBLIC_BASE_URL (no cloud account; Docker).
# Set all three S3_* to use a bucket instead.
DATA_DIR=data
# Key that signs those links. Empty: one is generated once and kept in the database. openssl rand -hex 32
FILES_SIGNING_KEY=
# S3-compatible endpoint URL (leave empty for AWS S3). Supabase: https://<project-ref>.supabase.co/storage/v1/s3
# Neon Object Storage: its S3 endpoint; with it, leave SUPABASE_* empty and the bot sets the bucket's CORS at startup
S3_ENDPOINT=
# Bucket that stores uploaded files
S3_BUCKET=
# S3 access key id
S3_ACCESS_KEY=
# S3 secret access key
S3_SECRET_KEY=
# Supabase project URL (https://<project-ref>.supabase.co) and its secret key (sb_secret_...): the browser uploads files
# through Supabase signed upload links. Left empty here so a local copy keeps files on local disk (or uses S3_*).
# WARNING: if either is empty, uploads use an S3 presigned PUT instead (its bucket needs CORS, see docs/DEPLOY.md);
# the startup log says which ("uploads: supabase" or "uploads: s3")
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# S3 region (Supabase: the project's region, e.g. ap-southeast-1; "auto" for Cloudflare R2)
S3_REGION=auto
# Folder holding one pack (YAML file) per app, and registry.yaml: the apps that serve their own pack
PACKS_DIR=apps
# The registry as JSON instead of apps/registry.yaml, e.g. [{"id":"shop","site":"https://shop.example","secret_env":"SHOP_SECRET"}]
APPS=
# The owner's ceilings over every pack: a message's spend cap (caps a pack's message_usd_cap), the models a pack may
# name (comma-separated; empty: any), and one app's model spend per UTC day (empty: no cap; past it, "resting")
MAX_MESSAGE_USD=0.25
ALLOWED_MODELS=
MAX_APP_DAILY_USD=
# Public URL of this service, no trailing slash (fills {base} in packs, used by the demo and the widget)
PUBLIC_BASE_URL=http://localhost:8000
# Whole-demo spend cap per day in USD; past it the demo replies "The demo is resting until tomorrow."
DEMO_DAILY_USD_CAP=3.0
# Set to false only in tests and smoke checks: skips the database and storage at startup
RUN_LIFESPAN=true
# Seconds to let running chat turns finish and charge on shutdown (Vercel gives a function about 500 ms)
SHUTDOWN_DRAIN_SECONDS=0.4
# Vercel Cron sends this as `Authorization: Bearer ...` to GET /internal/cleanup (daily); unset, the endpoint is off. openssl rand -hex 32
CRON_SECRET=
# Secret the demo pack signs session tokens with (a pack's secret_env). This placeholder works on localhost only (the bot
# refuses it anywhere else): set your own with openssl rand -hex 32
DEMO_SESSION_SECRET=local-demo-secret-change-before-you-expose-this-bot
# One secret per app you serve (its registry entry's or pack's secret_env), shared with that app. An app whose secret
# is unset is off (the startup log says so). HookPlaybook, listed in apps/registry.yaml, needs this only on its own bot.
HOOKPLAYBOOK_SESSION_SECRET=
