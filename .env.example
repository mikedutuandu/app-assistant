# OpenRouter key used for every model call
OPENROUTER_API_KEY=sk-or-replace-me
# Postgres connection string (app data and LangGraph checkpoints)
DATABASE_URL=postgresql://user:password@localhost:5432/assistant
# S3-compatible endpoint URL (leave empty for AWS S3)
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
# Bucket that stores uploaded files
S3_BUCKET=app-assistant
# S3 access key id
S3_ACCESS_KEY=replace-me
# S3 secret access key
S3_SECRET_KEY=replace-me
# S3 region ("auto" for Cloudflare R2)
S3_REGION=auto
# Folder holding one pack (YAML file) per app
PACKS_DIR=apps
# Public URL of this service, no trailing slash (fills {base} in packs, used by the demo and the widget)
PUBLIC_BASE_URL=http://localhost:8000
# Whole-demo spend cap per day in USD; past it the demo replies "The demo is resting until tomorrow."
DEMO_DAILY_USD_CAP=3.0
# Set to false only in tests and smoke checks: skips the database, storage and background jobs at startup
RUN_LIFESPAN=true
# Seconds to let running chat turns finish and charge on shutdown (Cloud Run gives about 10 after SIGTERM)
SHUTDOWN_DRAIN_SECONDS=8.0
# Secret the demo pack signs session tokens with (a pack's secret_env); generate with: openssl rand -hex 32
DEMO_SESSION_SECRET=replace-with-64-hex-characters
