# OpenRouter key used for every model call
OPENROUTER_API_KEY=sk-or-replace-me
# Postgres connection string (app data and LangGraph checkpoints). On Supabase: the Session pooler string (port 5432)
DATABASE_URL=postgresql://user:password@localhost:5432/assistant
# Schema every table lives in (created on start). On Supabase, never add it to the API's "Exposed schemas"
DB_SCHEMA=assistant
# Connections per instance: the app's pool and LangGraph's. Instances alive x 2 (x 3 when busy) must stay under the pooler's size
DB_POOL_MAX=2
SAVER_POOL_MAX=1
# S3-compatible endpoint URL (leave empty for AWS S3). Supabase: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
# Bucket that stores uploaded files
S3_BUCKET=app-assistant
# S3 access key id
S3_ACCESS_KEY=replace-me
# S3 secret access key
S3_SECRET_KEY=replace-me
# Supabase project URL (https://<project-ref>.supabase.co) and its secret key (sb_secret_...): the browser uploads files
# through Supabase signed upload links. Left empty here so a local copy uses the S3 path (MinIO).
# WARNING: if either is empty, uploads use an S3 presigned PUT instead (its bucket needs CORS, see the README);
# the startup log says which ("uploads: supabase" or "uploads: s3")
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# S3 region (Supabase: the project's region, e.g. ap-southeast-1; "auto" for Cloudflare R2)
S3_REGION=auto
# Folder holding one pack (YAML file) per app
PACKS_DIR=apps
# Public URL of this service, no trailing slash (fills {base} in packs, used by the demo and the widget)
PUBLIC_BASE_URL=http://localhost:8000
# Whole-demo spend cap per day in USD; past it the demo replies "The demo is resting until tomorrow."
DEMO_DAILY_USD_CAP=3.0
# Set to false only in tests and smoke checks: skips the database and storage at startup
RUN_LIFESPAN=true
# Seconds to let running chat turns finish and charge on shutdown (Vercel gives a function about 500 ms)
SHUTDOWN_DRAIN_SECONDS=0.4
# Vercel Cron sends this as `Authorization: Bearer ...` to GET /internal/cleanup (daily); unset, the endpoint is off. openssl rand -hex 32
CRON_SECRET=replace-with-64-hex-characters
# Secret the demo pack signs session tokens with (a pack's secret_env); generate with: openssl rand -hex 32
DEMO_SESSION_SECRET=replace-with-64-hex-characters
# Secret HookPlaybook signs its session and delete tokens with: the same value as HookPlaybook's ASSISTANT_TOKEN_SECRET
HOOKPLAYBOOK_SESSION_SECRET=replace-with-64-hex-characters
