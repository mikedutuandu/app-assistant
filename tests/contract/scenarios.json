[
  {
    "name": "context: the user's profile",
    "setup": {
      "context": {
        "language": "en",
        "name": "Mai",
        "voice": "Plain, short sentences, no hype.",
        "topics": [
          "release notes"
        ],
        "recent_posts": [
          "We shipped dark mode."
        ],
        "patterns": [
          "Lead with the number."
        ],
        "kept_facts": [
          {
            "id": "f1",
            "text": "Sign-ups doubled in March"
          }
        ],
        "credits_left": 12.5,
        "out_of_credits_message": "You're out of credits. Top up in Billing."
      }
    },
    "call": {
      "method": "context",
      "args": {}
    },
    "request": {
      "method": "POST",
      "path": "/context",
      "headers": {
        "authorization": "Bearer <token>",
        "content-type": "application/json",
        "accept": "application/json",
        "idempotency-key": null
      },
      "body": {}
    },
    "response_status": 200,
    "response_body": {
      "language": "en",
      "name": "Mai",
      "voice": "Plain, short sentences, no hype.",
      "topics": [
        "release notes"
      ],
      "recent_posts": [
        "We shipped dark mode."
      ],
      "patterns": [
        "Lead with the number."
      ],
      "kept_facts": [
        {
          "id": "f1",
          "text": "Sign-ups doubled in March"
        }
      ],
      "credits_left": 12.5,
      "out_of_credits_message": "You're out of credits. Top up in Billing."
    },
    "expect": {
      "returns": {
        "language": "en",
        "name": "Mai",
        "voice": "Plain, short sentences, no hype.",
        "topics": [
          "release notes"
        ],
        "recent_posts": [
          "We shipped dark mode."
        ],
        "patterns": [
          "Lead with the number."
        ],
        "kept_facts": [
          {
            "id": "f1",
            "text": "Sign-ups doubled in March"
          }
        ],
        "credits_left": 12.5,
        "out_of_credits_message": "You're out of credits. Top up in Billing."
      }
    }
  },
